# Plain-text template. Copy to .env locally; never commit the filled .env.
# Keep every expected variable documented here with an empty value.
# The static shell starts without any of these variables.

# Public browser configuration. These values will be visible in the built site.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional public deployment setting. Hostname only, without https:// or a path.
# In GitHub Actions set this as a repository Variable, not a frontend secret.
PAGES_CUSTOM_DOMAIN=

# Optional, server-only: Telegram bot (stage 13). The integration is enabled only
# when TELEGRAM_BOT_TOKEN, TELEGRAM_BOT_USERNAME and TELEGRAM_WEBHOOK_SECRET are
# all set; without them the site works and Telegram shows as not connected.
# Never prefix with VITE_. In the cloud set them in Supabase Secrets.
# TELEGRAM_BOT_TOKEN: secret token from BotFather (use a separate test bot locally).
# TELEGRAM_BOT_USERNAME: bot username without @; not secret, but server-only.
# TELEGRAM_WEBHOOK_SECRET: secret, 32+ characters of A-Z a-z 0-9 _ -; Telegram
#   sends it in X-Telegram-Bot-Api-Secret-Token with every webhook call.
# SITE_URL: optional public site address used in bot replies, e.g. https://<domain>/.
# TELEGRAM_API_BASE: optional, tests only — fake Bot API instead of api.telegram.org.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SITE_URL=
TELEGRAM_API_BASE=

# Server-only secrets for future bot integrations; not connected (Q-86).
MAX_BOT_TOKEN=
VK_BOT_TOKEN=

# Optional: Resend SMTP for Supabase Auth emails (confirmation and recovery codes).
# Locally emails go to Mailpit and SMTP stays disabled in supabase/config.toml.
# Server-only: never prefix with VITE_. In the cloud set SMTP in project settings.
# AUTH_SMTP_HOST: smtp.resend.com; AUTH_SMTP_USER: resend;
# AUTH_SMTP_PASS: Resend API key (secret); AUTH_SMTP_ADMIN_EMAIL: verified sender
# address, e.g. no-reply@<your domain>; AUTH_SMTP_SENDER_NAME: e.g. Murr клан.
AUTH_SMTP_HOST=
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_ADMIN_EMAIL=
AUTH_SMTP_SENDER_NAME=

# Optional, owner only: direct Postgres connection string of the cloud project
# for `npm run admin:bootstrap` (first administrator, Q-32). Secret: never commit.
# Leave empty to target the local Supabase stack.
ADMIN_DATABASE_URL=

# Optional, server-only: shared secret of the weekly Supabase Cron call that
# creates the four recurring events (Q-42). Set the same value in Supabase
# Secrets (EVENTS_CRON_SECRET) and in Supabase Vault (events_cron_secret);
# never prefix with VITE_. Without it officers create them with the button.
EVENTS_CRON_SECRET=

# Optional, deploy only: cloud release by the agent from the maintainer's
# machine (AGENTS.md, step 6). Secrets; never in CI variables or the client.
# SUPABASE_ACCESS_TOKEN: Supabase personal access token; not needed when
#   `npx supabase login` already stored one.
# SUPABASE_DB_PASSWORD: cloud database password used by `supabase db push`.
# GH_TOKEN: GitHub token with push access to the repository; not needed when
#   `gh auth status` and `git push` already work.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
GH_TOKEN=

# Document any additional credentials and webhook secrets here when introduced.
# Supabase-provided runtime variables are managed by the platform; never copy
# real runtime credentials into this template or into frontend configuration.
