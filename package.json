{
  "name": "murr-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "clean-install": "npm ci",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/check-secrets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "security:check": "node scripts/check-secrets.mjs",
    "pages:prepare": "node scripts/prepare-pages.mjs",
    "check": "npm run security:check && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:functions": "supabase functions serve --env-file .env"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "oxlint": "1.92.0",
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
