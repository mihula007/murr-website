{
  "name": "murr-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "clean-install": "npm clean-install",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/check-secrets.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "security:check": "node scripts/check-secrets.ts",
    "check:styles": "node scripts/check-styles.ts",
    "check:architecture": "node scripts/check-architecture.ts",
    "pages:prepare": "node scripts/prepare-pages.ts",
    "check": "npm run security:check && npm run check:styles && npm run check:architecture && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run build-storybook",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:functions": "supabase functions serve --env-file .env",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --quiet",
    "supabase:types": "supabase gen types typescript --schema app > supabase/functions/_shared/db/database.types.ts && prettier --write supabase/functions/_shared/db/database.types.ts",
    "supabase:test": "supabase test db",
    "test:server": "vitest run --config vitest.server.config.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env scripts/admin-bootstrap.ts",
    "e2e:functions": "node scripts/e2e-functions.ts",
    "telegram:dev": "node --env-file-if-exists=.env scripts/telegram-dev.ts",
    "telegram:webhook": "node --env-file-if-exists=.env scripts/telegram-webhook.ts",
    "supabase:env": "node scripts/supabase-env.ts",
    "seed:dev": "node scripts/seed-dev.ts --reset",
    "build:e2e": "node scripts/supabase-env.ts .env.e2e.local && tsc -b && vite build --mode e2e && node scripts/check-secrets.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource/cormorant": "5.3.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-heading": "3.33.1",
    "@tiptap/extension-image": "3.33.1",
    "@tiptap/extension-table": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "@tiptap/static-renderer": "3.33.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/node": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "cloudflared": "0.7.3",
    "jsdom": "31.0.0",
    "kysely": "0.29.7",
    "kysely-postgres-js": "5.0.1",
    "oxc-parser": "0.127.0",
    "oxlint": "1.92.0",
    "postgres": "3.4.9",
    "prettier": "3.9.10",
    "storybook": "10.6.6",
    "supabase": "3.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
