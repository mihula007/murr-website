{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "vitest", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect", "rejects"]
      }
    ]
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    ".tools/**",
    ".superpowers/**",
    ".agents/**",
    ".supabase/**",
    "prototype/**",
    ".playwright-mcp/**"
  ]
}
